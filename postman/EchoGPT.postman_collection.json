{
  "info": {
    "_postman_id": "7f3a1c52-8a9e-4d1b-9f0e-ec60e0a1b2c3",
    "name": "EchoGPT API",
    "description": "Generated from the OpenAPI document at /api/docs-json.\n\n1. Start the API (`npm run start:dev`) after `npm run migration:run` and `npm run seed`.\n2. Run **Auth → Log in as alice** (or **Log in as admin** for the Admin folders). The token is saved to `{{accessToken}}` automatically.\n3. Requests that create things (chat, search, providers) save their ids into collection variables used by later requests.\n\nDemo password for all demo accounts: `Password123!` (demo only).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
