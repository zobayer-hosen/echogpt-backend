              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const page = pm.response.json();",
                  "const user = (page.data || []).find((u) => u.role === 'USER');",
                  "if (user) pm.collectionVariables.set('targetUserId', user.id);"
                ]
              }
            }
          ]
