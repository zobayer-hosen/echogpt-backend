# EchoGPT Backend — environment variables (PRD §11)
# Copy to .env and fill in. The app refuses to start if a required value is missing or invalid.

NODE_ENV=development
PORT=3000

# Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echogpt
# Optional: e2e tests use this database. Defaults to DATABASE_URL with the database name "echogpt_test".
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echogpt_test

# JWT (long random strings, at least 32 characters, different from each other)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AES-256-GCM key for provider API keys: 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

# Plan limits (requests per UTC day)
FREE_DAILY_LIMIT=20
PREMIUM_DAILY_LIMIT=500

# CORS allow-list, comma separated
CORS_ORIGINS=http://localhost:3000,chrome-extension://<id>

# Web search cache lifetime
SEARCH_CACHE_TTL_SECONDS=3600

# AI provider timeout
AI_REQUEST_TIMEOUT_MS=30000

# Rate limits per IP (PRD §9)
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
